{
  "name": "specflow",
  "version": "0.1.0",
  "description": "Spec-driven development orchestration: define features, agents implement them via pluggable harnesses & LLM providers, teams collaborate via configurable channels.",
  "type": "module",
  "main": "src/api/server-entry.js",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/api/server-entry.js",
    "dev": "node --watch src/api/server-entry.js",
    "cli": "node src/cli.js",
    "api": "node src/api/server.js",
    "build:web": "cd web && npm ci --omit=dev && cd ..",
    "setup": "node scripts/setup.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "js-yaml": "^4.1.0",
    "octokit": "^3.2.1",
    "simple-git": "^3.25.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {}
}