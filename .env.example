# ---- SpecFlow runtime settings ----
SPECFLOW_PORT=9120
SPECFLOW_DB=./data/specflow.db
SPECFLOW_REPO_ROOT=./work

# ---- LLM providers (plugin whichever you use) ----
# OpenRouter
OPENROUTER_API_KEY=
# NVIDIA NIM
NVIDIA_API_KEY=
# Google Gemini
GOOGLE_API_KEY=

# ---- Git / GitHub ----
# Personal access token with repo & pull-request scopes, for auto-opening PRs
GITHUB_TOKEN=

# ---- Optional channel: WhatsApp outbound webhook relay ----
# SPECFLOW_WHATSAPP_MODE=webhook
# SPECFLOW_WHATSAPP_WEBHOOK_URL=
# SPECFLOW_WHATSAPP_TARGET=whatsapp:+351916241077

# ---- Harness executables (optional) ----
# HERMES_BIN=hermes